IMPORT M6502, Out;

CONST
  MemSize = 64 * 1024;
VAR
  mem: ARRAY MemSize OF CHAR;
  cpu: M6502.CPU;
  oldPc: INTEGER;

PROCEDURE ReadMem(where: INTEGER): INTEGER;
BEGIN
  RETURN ORD(mem[where]) BITAND 255
END ReadMem;

PROCEDURE WriteMem(where, what: INTEGER);
BEGIN
  mem[where] := CHR(what)
END WriteMem;

PROCEDURE RunTest(testName: ARRAY OF CHAR; successPc: INTEGER);
VAR
  steps: INTEGER;
BEGIN
  Out.ReadFile(testName, mem);
  cpu.a := 0;
  cpu.x := 0;
  cpu.y := 0;
  cpu.sp := 255;
  cpu.pc := 400H;
  cpu.flags := {M6502.reserveD};
  cpu.readProc := ReadMem;
  cpu.writeProc := WriteMem;
  cpu.halt := FALSE;
  oldPc := 0;
  steps := 0;
  WHILE (oldPc # cpu.pc) & ~cpu.halt DO
    INC(steps);
    oldPc := cpu.pc;
    M6502.Step(cpu)
  END;
  (* When the test completes, it goes into a tight loop. *)
  (* This represents the success ending PC.              *)
  ASSERT(oldPc = successPc);
  Out.Str(testName);
  Out.Str(" passed in ");
  Out.Int(steps);
  Out.Str(" steps");
  Out.Ln
END RunTest;

BEGIN
  RunTest("6502_functional_test.bin", 3469H);
  RunTest("65C02_extended_opcodes_test.bin", 24F1H)
END Test6502.
